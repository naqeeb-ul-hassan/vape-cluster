# =============================================================================
# vape_cluster - Environment Variables Example
# Copy this file to .env and fill in your actual values
# Never commit the real .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# DJANGO CORE SETTINGS
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ENV=development

# -----------------------------------------------------------------------------
# MYSQL DATABASE SETTINGS
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vape_cluster_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_CHARSET=utf8mb4
DB_CONN_MAX_AGE=60

# -----------------------------------------------------------------------------
# PAYFAST PAYMENT GATEWAY SETTINGS
# -----------------------------------------------------------------------------
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_USERNAME=your-payfast-merchant-username
PAYFAST_SECURED_KEY=your-payfast-secured-key
PAYFAST_API_URL=https://sandbox.payfast.pk/
PAYFAST_CHECKOUT_URL=https://sandbox.payfast.pk/order/checkout/pay
SITE_URL=http://localhost:8000
PAYFAST_RETURN_URL=http://localhost:8000/orders/payment/success/
PAYFAST_CANCEL_URL=http://localhost:8000/orders/payment/cancel/
PAYFAST_IPN_URL=http://localhost:8000/orders/payment/ipn/
PAYFAST_SANDBOX=True
PAYFAST_PAYMENT_METHOD=

# -----------------------------------------------------------------------------
# EMAIL SETTINGS
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=Vape Cluster <noreply@vapecluster.com>
ADMIN_EMAIL=admin@vapecluster.com

# -----------------------------------------------------------------------------
# REDIS & CELERY SETTINGS
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# -----------------------------------------------------------------------------
# OAUTH SETTINGS (Google & Facebook)
# -----------------------------------------------------------------------------
GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# -----------------------------------------------------------------------------
# AWS S3 SETTINGS (Optional)
# -----------------------------------------------------------------------------
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=vape-cluster-media
AWS_S3_REGION_NAME=ap-south-1

# -----------------------------------------------------------------------------
# SECURITY SETTINGS
# -----------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
AGE_VERIFICATION_MIN_AGE=21
